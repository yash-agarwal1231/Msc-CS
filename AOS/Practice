Q2. Write a C program where a parent process controls a child process using signals: SIGSTOP
    (suspend), SIGCONT (resume), and SIGTERM (terminate). The parent takes user input(‘s’,’r’&’q’)
    to send the respective signals, handles invalid inputs, and ensures proper child termination.

#include <stdio.h>
#include <unistd.h>
#include <signal.h>
#include <sys/wait.h>

int main()
{
    int pid;
    char ch;

    pid = fork();

    if (pid == 0)
    {
        while (1)
        {
            printf("Child process running\n");
            sleep(2);
        }
    }
    else if (pid > 0)
    {
        while (1)
        {
            printf("\ns: Suspend  r: Resume  q: Quit\n");
            printf("Enter choice: ");
            scanf(" %c", &ch);

            if (ch == 's')
                kill(pid, SIGSTOP);
            else if (ch == 'r')
                kill(pid, SIGCONT);
            else if (ch == 'q')
            {
                kill(pid, SIGTERM);
                wait(NULL);
                printf("Child terminated\n");
                break;
            }
            else
                printf("Invalid choice\n");
        }
    }
    else
        printf("Fork failed\n");

    return 0;
}
