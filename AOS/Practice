Q8. Write a C program to read the current directory and display names, size, and type of the file.
    Display total number of files in the current directory. Also create a file with a hole in the current
    directory.

#include <stdio.h>
#include <dirent.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    DIR *dir;
    struct dirent *entry;
    struct stat file;
    int fd, count = 0;

    dir = opendir(".");

    if (dir == NULL)
    {
        printf("Cannot open directory\n");
        return 1;
    }

    printf("Name\t\tSize\tType\n");

    while ((entry = readdir(dir)) != NULL)
    {
        if (stat(entry->d_name, &file) == -1)
            continue;

        printf("%s\t%ld\t", entry->d_name, (long)file.st_size);

        if (S_ISREG(file.st_mode))
            printf("Regular file\n");
        else if (S_ISDIR(file.st_mode))
            printf("Directory\n");
        else
            printf("Other\n");

        count++;
    }

    closedir(dir);

    printf("Total entries: %d\n", count);

    fd = open("hole.txt",
              O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd == -1)
    {
        printf("Cannot create hole file\n");
        return 1;
    }

    write(fd, "Hello", 5);

    lseek(fd, 5, SEEK_CUR);

    write(fd, "World", 5);

    close(fd);

    printf("File with hole created successfully\n");

    return 0;
}
