Q4. Write an interactive C program to demonstrate the use of dynamic memory allocation functions.
    The program should handle memory allocation, reallocation, and de-allocation.

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int *p, n, i, ch;

    p = NULL;
    n = 0;

    do
    {
        printf("\n1. Allocate");
        printf("\n2. Display");
        printf("\n3. Reallocate");
        printf("\n4. Free memory");
        printf("\n5. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        if (ch == 1)
        {
            if (p != NULL)
            {
                printf("Memory already allocated\n");
                continue;
            }

            printf("Enter size: ");
            scanf("%d", &n);

            if (n <= 0)
            {
                printf("Invalid size\n");
                n = 0;
                continue;
            }

            p = (int *)malloc(n * sizeof(int));

            if (p == NULL)
            {
                printf("Allocation failed\n");
                n = 0;
                continue;
            }

            for (i = 0; i < n; i++)
            {
                printf("Enter element: ");
                scanf("%d", &p[i]);
            }
        }
        else if (ch == 2)
        {
            if (p == NULL)
                printf("Memory not allocated\n");
            else
                for (i = 0; i < n; i++)
                    printf("%d ", p[i]);
        }
        else if (ch == 3)
        {
            if (p == NULL)
            {
                printf("Allocate memory first\n");
                continue;
            }

            printf("Enter new size: ");
            scanf("%d", &i);

            if (i <= 0)
            {
                printf("Invalid size\n");
                continue;
            }

            {
                int *temp = realloc(p, i * sizeof(int));

                if (temp == NULL)
                    printf("Reallocation failed\n");
                else
                {
                    p = temp;
                    n = i;
                    printf("Memory reallocated\n");
                }
            }
        }
        else if (ch == 4)
        {
            free(p);
            p = NULL;
            n = 0;
            printf("Memory freed\n");
        }
        else if (ch != 5)
            printf("Invalid choice\n");

    } while (ch != 5);

    free(p);
    return 0;
}
