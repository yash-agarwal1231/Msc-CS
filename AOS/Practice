Q6. Write a C program to demonstrate the use of atexit() by registering three exit functions,
    ensuring they execute in reverse order of registration. The first exit function should free
    dynamically allocated memory with a null check condition, while the others display appropriate
    messages.


#include <stdio.h>
#include <stdlib.h>

int *p;

void fun1()
{
    if (p != NULL)
    {
        free(p);
        p = NULL;
        printf("Memory freed\n");
    }
    else
        printf("Memory is NULL\n");
}

void fun2()
{
    printf("Second exit function executed\n");
}

void fun3()
{
    printf("Third exit function executed\n");
}

int main()
{
    p = (int *)malloc(5 * sizeof(int));

    if (p == NULL)
    {
        printf("Memory allocation failed\n");
        return 1;
    }

    atexit(fun1);
    atexit(fun2);
    atexit(fun3);

    printf("Main function completed\n");

    return 0;
}

