Q3. Write a C program to demonstrate suspending and resuming a process using signals (SIGTSTP
    and SIGCONT). The program should handle these signals and manage the execution state of
    process effectively.

#include <stdio.h>
#include <unistd.h>
#include <signal.h>
#include <sys/wait.h>

int main()
{
    int pid;

    pid = fork();

    if (pid == 0)
    {
        while (1)
        {
            printf("Child process running\n");
            sleep(2);
        }
    }
    else if (pid > 0)
    {
        sleep(5);

        printf("Suspending child process\n");
        kill(pid, SIGTSTP);
        sleep(5);

        printf("Resuming child process\n");
        kill(pid, SIGCONT);
        sleep(5);

        printf("Terminating child process\n");
        kill(pid, SIGTERM);

        wait(NULL);
    }
    else
        printf("Fork failed\n");

    return 0;
}
