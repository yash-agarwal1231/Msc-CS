Q5. Write a C program that lists all files in the current directory, allows the user to create a file with
    specified content, reads and displays the file&#39;s content, and ensures proper handling of file
    operations.

#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>
#include <dirent.h>

int main()
{
    DIR *dir;
    struct dirent *entry;
    int fd, n;
    char name[100], content[200], buffer[200];

    dir = opendir(".");

    if (dir == NULL)
    {
        printf("Cannot open directory\n");
        return 1;
    }

    printf("Files in current directory:\n");

    while ((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(dir);

    printf("Enter filename: ");
    scanf("%99s", name);

    fd = open(name, O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd == -1)
    {
        printf("Cannot create file\n");
        return 1;
    }

    printf("Enter content (one line): ");
    getchar();

    if (fgets(content, sizeof(content), stdin) == NULL)
    {
        close(fd);
        return 1;
    }

    write(fd, content, strlen(content));
    close(fd);

    fd = open(name, O_RDONLY);

    if (fd == -1)
    {
        printf("Cannot read file\n");
        return 1;
    }

    n = read(fd, buffer, sizeof(buffer) - 1);

    if (n >= 0)
    {
        buffer[n] = '\0';
        printf("File content: %s", buffer);
    }

    close(fd);
    return 0;
}
