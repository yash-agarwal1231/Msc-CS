1. Sum values of an array using sum() and a for loop
------------------------------------------------------------

object Assignment1 {
  def main(args: Array[String]): Unit = {
    val numbers = Array(10, 20, 30, 40, 50)

    // Method 1: Using sum()
    println("Sum using sum(): " + numbers.sum)

    // Method 2: Using a for loop
    var total = 0
    for (num <- numbers) {
      total += num
    }

    println("Sum using for loop: " + total)
  }
}

Sample output:
Sum using sum(): 150
Sum using for loop: 150


