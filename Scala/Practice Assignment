2. Calculate the average of array elements (accept input)
------------------------------------------------------------

import scala.io.StdIn

object Assignment2 {
  def main(args: Array[String]): Unit = {
    print("Enter the number of elements: ")
    val n = StdIn.readInt()

    if (n <= 0) {
      println("Please enter a positive number of elements.")
    } else {
      val numbers = new Array[Int](n)

      for (i <- 0 until n) {
        print(s"Enter element ${i + 1}: ")
        numbers(i) = StdIn.readInt()
      }

      val average = numbers.sum.toDouble / n
      println("Average: " + average)
    }
  }
}

Sample run:
Enter the number of elements: 4
Enter element 1: 10
Enter element 2: 20
Enter element 3: 30
Enter element 4: 40
Average: 25.0


------------------------------------------------------------
3. Sum of the last 3 elements of an array
------------------------------------------------------------

object Assignment3 {
  def main(args: Array[String]): Unit = {
    val numbers = Array(10, 20, 30, 40, 50)

    val result =
      if (numbers.isEmpty) 0
      else if (numbers.length < 3) numbers.sum
      else numbers.takeRight(3).sum

    println("Array: " + numbers.mkString(", "))
    println("Result: " + result)
  }
}

Sample output:
Array: 10, 20, 30, 40, 50
Result: 120

Explanation of the conditions:
- Empty array: returns 0.
- Fewer than 3 elements: returns the sum of the whole array.
- 3 or more elements: returns the sum of the last 3 elements.


